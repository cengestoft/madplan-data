{
  "schema_version": 1,
  "updated_at": "2026-10-05T20:20:00+02:00",
  "currency": "DKK",
  "applies_to": "all stores present in current_offers.json and next_week_offers.json",
  "rules": [
    {
      "id": "cola_24_cans",
      "label": "Coca-Cola 24 dåser",
      "active": true,
      "match": {
        "category": "drikkevarer",
        "product_type": "cola",
        "container": "can",
        "package_count": 24,
        "allowed_brands": [
          "Coca Cola",
          "Coca-Cola"
        ],
        "exclude_terms": [
          "Zero",
          "Light",
          "Pepsi",
          "Pepsi Max",
          "Fanta"
        ]
      },
      "threshold": {
        "metric": "package_price_dkk",
        "operator": "<",
        "value": 69
      },
      "notes": "Kun almindelig Coca-Cola. Zero, Light, Pepsi/Pepsi Max, Fanta og andre sodavand må ikke matche. Pant må ikke indgå i price_dkk."
    },
    {
      "id": "cola_large_bottle",
      "label": "Coca-Cola 1,25-2 L flaske",
      "active": true,
      "match": {
        "category": "drikkevarer",
        "product_type": "cola",
        "container": "bottle",
        "volume_l_min": 1.25,
        "volume_l_max": 2,
        "allowed_brands": [
          "Coca Cola",
          "Coca-Cola"
        ],
        "exclude_terms": [
          "Zero",
          "Light",
          "Pepsi",
          "Pepsi Max",
          "Fanta"
        ]
      },
      "threshold": {
        "metric": "unit_price_dkk_per_l",
        "operator": "<",
        "value": 11
      },
      "notes": "Kun almindelig Coca-Cola i flasker fra 1,25 til 2,0 liter. Zero, Light, Pepsi/Pepsi Max, Fanta og andre sodavand må ikke matche. Pant holdes separat."
    },
    {
      "id": "real_butter",
      "label": "Rigtigt smør",
      "active": true,
      "match": {
        "category": "mejeri",
        "product_type": "butter",
        "exclude_terms": [
          "smørbar",
          "blandingsprodukt",
          "spread",
          "Kærgården"
        ],
        "require_product_type": "butter"
      },
      "threshold": {
        "metric": "unit_price_dkk_per_kg",
        "operator": "<=",
        "value": 40
      },
      "notes": "Kun egentlige smørprodukter med product_type=butter. Smørbar/blandingsprodukter og andre varer med ordet 'smør' i navnet må ikke matche."
    },
    {
      "id": "whipping_cream",
      "label": "Piskefløde",
      "active": true,
      "match": {
        "product_type": "whipping_cream",
        "name_contains": [
          "piskefløde"
        ],
        "fat_pct_min": 36
      },
      "threshold": {
        "metric": "unit_price_dkk_per_l",
        "operator": "<=",
        "value": 25
      },
      "equivalent": "500 ml <= 12,50 kr.",
      "notes": "Match piskefløde by product/name, not by category, so a source-category error cannot hide the offer."
    },
    {
      "id": "dishwasher_tabs",
      "label": "Opvasketabs",
      "active": true,
      "match": {
        "category": "husholdning",
        "product_type": "dishwasher_tabs"
      },
      "threshold": {
        "metric": "unit_price_dkk_per_tab",
        "operator": "<=",
        "value": 0.75
      }
    },
    {
      "id": "toilet_paper",
      "label": "Toiletpapir 3-lags",
      "active": true,
      "match": {
        "category": "husholdning",
        "product_type": "toilet_paper",
        "plies": 3
      },
      "threshold": {
        "metric": "unit_price_dkk_per_roll",
        "operator": "<=",
        "value": 2
      }
    }
  ],
  "behavior": {
    "show_on_superdeals": true,
    "show_on_homepage": true,
    "allow_manual_rules": true,
    "compare_normalized_units": true,
    "exclude_deposit_from_price": true
  }
}
